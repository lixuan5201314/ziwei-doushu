# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 账号与后台 ───
# 单机部署推荐 SQLite，不需要额外安装数据库软件。
DATABASE_URL=sqlite:./.data/ziwei.db
# 多实例或云部署改用 PostgreSQL：
# DATABASE_URL=postgresql://user:password@host:5432/ziwei
# 某些托管数据库需要 SSL；本地数据库可设为 false。
DATABASE_SSL=false
# 这些邮箱注册后自动成为管理员，多个邮箱用英文逗号分隔。
ADMIN_EMAILS=admin@example.com
# 登录有效期，单位为天，最大 90 天。
AUTH_SESSION_DAYS=30
# 本机 HTTP 使用 false；部署到 HTTPS 时改为 true。
AUTH_COOKIE_SECURE=false
